{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "server/**/*.ts",
    "src/main.tsx",
    "src/App.tsx",
    "src/types.ts",
    "src/context/**/*.tsx",
    "src/hooks/useAuditIntegrity.ts",
    "src/services/NativeMemoryController.ts",
    "src/utils/auditLedger.ts",
    "src/components/Header.tsx",
    "src/components/LanguageSwitcher.tsx",
    "src/components/MobileNav.tsx",
    "src/components/ResourceMonitor.tsx",
    "src/components/Sidebar.tsx",
    "src/components/StreamingTokenDisplay.tsx",
    "src/components/ThemeSwitcher.tsx",
    "src/components/ui/**/*.tsx",
    "src/components/ui/tokens.ts",
    "src/components/modules/AdminConsole.tsx",
    "src/components/modules/AnalyticsBI.tsx",
    "src/components/modules/ApiPlatform.tsx",
    "src/components/modules/AutomationCenter.tsx",
    "src/components/modules/BenchmarkArena.tsx",
    "src/components/modules/CommandCenter.tsx",
    "src/components/modules/ConversationalIntelligence.tsx",
    "src/components/modules/DevStudio.tsx",
    "src/components/modules/ExperimentCenter.tsx",
    "src/components/modules/GovernanceSecurity.tsx",
    "src/components/modules/IntelligenceCore.tsx",
    "src/components/modules/KnowledgeHub.tsx",
    "src/components/modules/Marketplace.tsx",
    "src/components/modules/ModelLaboratory.tsx",
    "src/components/modules/ResearchLab.tsx",
    "src/components/modules/SubscriptionBilling.tsx",
    "src/components/modules/SystemAuditLedger.tsx",
    "src/components/modules/UserSettings.tsx",
    "lib/AuditLedger.ts",
    "lib/AuthMiddleware.ts",
    "lib/CommercialManager.ts",
    "lib/DocumentBinaryParser.ts",
    "lib/KnowledgeIntelligenceEngine.ts",
    "lib/KnowledgeWorkspace.ts",
    "lib/NativeMemoryController.ts",
    "lib/SovereignIdentity.ts",
    "lib/TaskOrchestrator.ts",
    "lib/TokenRevocation.ts",
    "lib/ToolGateway.ts",
    "lib/knowledgeUtils.ts",
    "lib/multipartMemory.ts",
    "lib/providers.ts",
    "vite.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
