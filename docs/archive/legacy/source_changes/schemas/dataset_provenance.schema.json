{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zyntheor.invalid/schemas/dataset-provenance-v1.json",
  "title": "ZYNTHEOR Dataset Provenance Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "near_duplicate_threshold", "documents"],
  "properties": {
    "schema_version": {"const": "zyntheor.dataset-provenance.v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "near_duplicate_threshold": {"type": "number", "minimum": 0.5, "maximum": 1.0},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "media_type": {"type": "string"}}
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "document_sha256", "split", "source", "license", "rights", "approval", "evidence"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "split": {"enum": ["train", "validation", "test"]},
        "language": {"enum": ["th", "en", "multilingual", "und"]},
        "source": {"type": "object", "additionalProperties": false, "required": ["url", "publisher"], "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://"}, "publisher": {"type": "string", "minLength": 1}}},
        "license": {"type": "object", "additionalProperties": false, "required": ["id", "url"], "properties": {"id": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}}},
        "rights": {"type": "object", "additionalProperties": false, "required": ["basis", "scope"], "properties": {"basis": {"type": "string", "minLength": 1}, "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
        "approval": {"type": "object", "additionalProperties": false, "required": ["decision", "approver", "signed_at", "key_id", "signature"], "properties": {"decision": {"enum": ["PENDING", "APPROVED", "REJECTED"]}, "approver": {"type": "string", "minLength": 1}, "signed_at": {"type": "string", "format": "date-time"}, "key_id": {"type": "string", "minLength": 1}, "signature": {"type": "string", "minLength": 1}}},
        "evidence": {"type": "object", "additionalProperties": false, "required": ["source", "license", "rights", "approval"], "properties": {"source": {"$ref": "#/$defs/evidence"}, "license": {"$ref": "#/$defs/evidence"}, "rights": {"$ref": "#/$defs/evidence"}, "approval": {"$ref": "#/$defs/evidence"}}}
      }
    }
  }
}
