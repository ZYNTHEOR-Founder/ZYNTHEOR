{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ZYNTHEOR_ENABLE_DEV_LOGIN=true tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/sovereignty.test.ts",
    "test:identity": "node tests/identity-trust.run.mjs",
    "test:all": "node tests/identity-trust.run.mjs && node tests/knowledge-intelligence.run.mjs && node tests/security-rbac-integrity.run.mjs && node --experimental-strip-types tests/knowledge_e2e.test.ts",
    "test:knowledge": "node tests/knowledge-intelligence.run.mjs",
    "test:live": "node tests/knowledge-live-http.run.mjs",
    "test:knowledge-e2e": "node --experimental-strip-types tests/knowledge_e2e.test.ts",
    "test:security": "node tests/security-rbac-integrity.run.mjs",
    "test:live-training": "node tests/live-training-e2e.mjs",
    "train:continue": "node tests/continue-training-e2e.mjs",
    "test:product-integrity": "node tests/online-product-integrity.test.mjs",
    "test:python": "python3 tests/native-lm-v2.test.py -v",
    "test:bilingual": "python3 -c \"from qplus_native.model import NativeNeuralModel; from qplus_native.bridge import run_language_integrity_suite; import json; print(json.dumps(run_language_integrity_suite(NativeNeuralModel()), ensure_ascii=False, indent=2))\"",
    "test:security-static": "node tests/security-hardening-static.test.mjs",
    "test:ledger": "node --experimental-strip-types src/tests/ledger-cli.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
