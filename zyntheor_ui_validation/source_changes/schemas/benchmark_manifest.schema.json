{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zyntheor.invalid/schemas/benchmark-v1.json",
  "title": "ZYNTHEOR Intelligence Benchmark Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "near_duplicate_threshold", "tasks"],
  "properties": {
    "schema_version": {"const": "zyntheor.benchmark.v1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "near_duplicate_threshold": {"type": "number", "minimum": 0.5, "maximum": 1.0},
    "status": {"enum": ["DRAFT", "REVIEW_REQUIRED", "READY_FOR_EVALUATION"]},
    "required_domains": {"const": ["thai_english_understanding", "mathematics", "science", "coding", "multi_step_reasoning", "planning", "self_correction"]},
    "notes": {"type": "string"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "document_id", "document_sha256", "domain", "language", "split", "prompt", "expected", "scorer", "source", "license", "rights", "approval", "evidence"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "domain": {"enum": ["thai_english_understanding", "mathematics", "science", "coding", "multi_step_reasoning", "planning", "self_correction"]},
        "language": {"enum": ["th", "en", "multilingual", "und"]},
        "split": {"const": "test"},
        "prompt": {"type": "string", "minLength": 1},
        "expected": {"type": "string"},
        "scorer": {"enum": ["exact_match", "normalized_exact_match", "contains", "human_rubric"]},
        "source": {
          "type": "object", "required": ["url", "publisher"],
          "properties": {
            "url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "publisher": {"type": "string", "minLength": 1}
          }
        },
        "license": {
          "type": "object", "required": ["id", "url"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri", "pattern": "^https://"}
          }
        },
        "rights": {
          "type": "object", "required": ["basis", "scope"],
          "properties": {
            "basis": {"type": "string", "minLength": 1},
            "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "approval": {
          "type": "object", "required": ["decision", "approver", "signed_at", "key_id", "signature"],
          "properties": {
            "decision": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
            "approver": {"type": "string", "minLength": 1},
            "signed_at": {"type": "string", "format": "date-time"},
            "key_id": {"type": "string", "minLength": 1},
            "signature": {"type": "string", "minLength": 1}
          }
        },
        "evidence": {
          "type": "object", "required": ["source", "license", "rights", "approval"],
          "properties": {
            "source": {"$ref": "#/$defs/evidence"},
            "license": {"$ref": "#/$defs/evidence"},
            "rights": {"$ref": "#/$defs/evidence"},
            "approval": {"$ref": "#/$defs/evidence"}
          }
        }
      }
    }
  }
}
