ZYNTHEOR_ENABLE_DEV_LOGIN=false
ZYNTHEOR_MASTER_SECRET=
# Competitive browser benchmarks: exact preview origins only; comma-separated.
# Example: https://preview.example.zyntheor.app
ZYNTHEOR_BENCHMARK_ALLOWED_ORIGINS=
# Loopback previews are permitted only in NODE_ENV=test and must be explicitly enabled.
ZYNTHEOR_ALLOW_LOOPBACK_BENCHMARK=0

# Native model serving is provided by the designated online Cloud Runtime.
CLOUD_RUNTIME_URL=
CHECKPOINT_PRESIGNED_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=
S3_CHECKPOINT_KEY=
ZYNTHEOR_CONNECTIVITY_PROBE_URL=
CHECKPOINT_UPLOAD_URL=
